#
# This script runs with interactive login - you just need to provide appropriate credentials when you run.
#
# Make sure you update tenant, filename and filepath as needed.  And update roles if NT Ware create new ones.
#
# The script will download a listing of all users from the tenant, then display and save to file a filtered 
# user list based on role.  This is handy for documenting all users in the tenant that have a privilege role.
# 

param (
   [Parameter(Mandatory)][string]$tenant, 
   [string]$username,
   [string]$password,
   [Parameter(Mandatory)][switch]$batch
)

# Load uniFLOW PowerShell module from PowerShell gallery - click "Yes to All" at user prompt

#Install-Module -Name NTware.Ufo.PowerShell.ObjectManagement -Scope CurrentUser

##  Update the uniFLOW Online PowerShell Module
Update-Module -Name NTware.Ufo.PowerShell.ObjectManagement
##  Import the uniFLOW Online PowerShell Module
Import-Module NTware.Ufo.PowerShell.ObjectManagement
# Find-Module NTware.Ufo.PowerShell.ObjectManagement

# Set up some variable to suit customer and runtime environment

$timeStamp = get-date -Format 'yyyyMMdd-hhmmss'

$folderpath = Get-Location
$fileName = ("uFO_user_roles_postfilter{0}.csv" -f $timeStamp)


# To recycle for other user filter type, see whitepaper - Name, NotificationEmail, Address, JobTitle, OfficePhone, IdentityType, IdentityValue
# Some filters lend themselves better to this style of listing (using multiple values in an array) than others...

$filterName = 'Role'
$filterValues = 'Administrator', 'BudgetManager', 'CostCenterManager', 'DeviceSystemManager', 'FleetManager', 'PartnerAdministrator', 'ReportsManager', 'UserAdministrator'

$time = get-date
write-host ("{0} - attempting to connect to {1}" -f $time, $tenant)

# Attempt interactive uFO tenant login - must be User Administrator or Administrator
# Attempt interactive uFO tenant login - must be User Administrator or Administrator
if($batch) {
    if(-not $username) {
        $time = get-date
        return ("{0} - script called in batch mode but -username not supplied - cannot connect to {1}" -f $time, $tenant)
    }
    if(-not $password) {
        $time = get-date
        return ("{0} - script called in batch mode but -password not supplied - cannot connect to {1}" -f $time, $tenant)
    }

    $time = get-date
    write-host ("{0} - attempting to connect to {1} via NonInteractiveUserApplication" -f $time, $tenant)
    try {
        $secStringPassword = ConvertTo-SecureString $password -AsPlainText -Force
        $credObject = New-Object System.Management.Automation.PSCredential($username,$secStringPassword)

        Open-MomoConnection -TenantDomain $tenant -NonInteractiveUserApplication $credObject
        $time = get-date
        write-host ("{0} - connected to {1} via NonInteractiveUserApplication" -f $time, $tenant)
    }
    catch {
        $time = get-date
        write-host ("{0} - failed to connect to {1} via NonInteractiveUserApplication - {2}" -f $time, $tenant, $_)
    }
}    
else {
    $time = get-date
    write-host ("{0} - attempting to connect to {1} via Interactive" -f $time, $tenant)
    try {
        Open-MomoConnection -TenantDomain $tenant -Interactive
        $time = get-date
        write-host ("{0} - connected to {1} via Interactive" -f $time, $tenant)
    }
    catch {
        $time = get-date
        write-host ("{0} - failed to connect to {1} via Interactive" -f $time, $tenant)
    }
}

# For each role, find all users with that role and save listing to a separate CSV file.

$time = get-date
write-host ("{0} - attempting to download user listing" -f $time)
try {
    $obj = Find-MomoUsers
    $time = get-date
    write-host ("{0} - successfully downloaded user listing" -f $time) 
}
catch {
    $time = get-date
    write-host ("{0} - failed to download user listing : {1}" -f $time,$_) 
}

# Close connection to uniFLOW - triggers a logout

$time = get-date
write-host ("{0} - attempting to close connection to uniFLOW tenant : {1}" -f $time,$tenant)
try {
    Close-MomoConnection
    $time = get-date
    write-host ("{0} - successfully closed connection to uniFLOW tenant : {1}" -f $time,$tenant) 
}
catch {
    $time = get-date
    write-host ("{0} - failed to close connection to uniFLOW tenant : {1} : {2}" -f $time,$tenant,$_) 
}

$time = get-date
write-host ("{0} - listing uniFLOW users by role" -f $time)

foreach ($item in $filterValues) {
    # Create array based on device listing from uniFLOW
    $time = get-date
    write-host ("{0} - Listing users where Role contains {1}" -f $time,$item)
    $obj | Where-Object -Property 'Roles' -Like $item

    $fileName = ("uFO_user_list_{0}_{1}-{2}.csv" -f $tenant, $item, $timeStamp)
    $filePath = ("{0}\{1}" -f$folderpath,$fileName)

    # Export array to CSV file - update file path and file name to suit
    $time = get-date
    write-host ("{0} - attempting to save list of {1} users with {2} equal to {3} to {4}" -f $time, {$obj | Where-Object -Property 'Roles' -Like $item}.count, $filterName, $item, $filePath)
    try {
        $obj | Where-Object -Property 'Roles' -Like $item | Export-Csv -Path $filePath -NoTypeInformation
        $time = get-date
        write-host ("{0} - saved list of {1} users with {2} equal to {3} to {4}" -f $time, {$obj | Where-Object -Property 'Roles' -Like $item}.count, $filterName, $item, $filePath)
    }
    catch {
        $time = get-date
        write-host ("{0} - failed to save list of {1} users with {2} equal to {3} to {4}" -f $time, {$obj | Where-Object -Property 'Roles' -Like $item}.count, $filterName, $item, $filePath)
    }

}

$time = get-date
write-host ("{0} - listing uniFLOW users by role completed" -f $time)
